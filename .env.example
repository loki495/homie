APP_NAME=Homie
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
STATIC_ASSET_HOSTS=

# Host port docker-compose.yml publishes the app container on (see "Local
# development" in README.md). Change this if 8090 collides with something
# else already running on your machine.
APP_PORT=8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Required only if you embed this dashboard in an <iframe> on a DIFFERENT
# origin (e.g. a Home Assistant dashboard card). The session cookie defaults
# to SameSite=Lax, which browsers do not send on cross-site subrequests - so
# inside such an iframe there is no session at all, which means no CSRF token,
# which means every POST fails. SameSite=None restores it; browsers only
# accept None together with Secure, so this needs HTTPS on the dashboard's
# own URL (Traefik already terminates TLS in the setup described in README).
# Leave both unset for a same-origin-only deployment - Lax is the safer
# default and there is no reason to widen it if nothing frames the app.
# SESSION_SAME_SITE=none
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Set these to your Traefik-routed vite hostname when developing via Docker/Traefik.
# Leave unset to fall back to localhost, e.g. running `npm run dev` directly on the host.
# VITE_HMR_HOST=vite.homie.dev.local.test
# VITE_HMR_PORT=80
