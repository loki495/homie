# Copy this file to .env.production. Do not commit the copied file.
APP_NAME=Homie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://homie.example.test

# This is loopback-only in docker-compose.production.yml. Your HTTPS reverse
# proxy must forward to http://127.0.0.1:8090 on the same host.
APP_PORT=8090

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

# File sessions avoid a database/session bootstrap dependency and are stored in
# the persistent homie-storage volume.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Leave demo mode off for a private self-hosted dashboard. No default admin
# account exists: create the one administrator after the containers are healthy.
DEMO_MODE=false
